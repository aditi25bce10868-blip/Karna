
# ==========================================
# KARNA - Git Ignore
# ==========================================

# --------------------------
# Dataset, audits and preparation
# --------------------------
/emergency_datset/

# --------------------------
# Python cache and compiled files
# --------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python

# --------------------------
# Virtual environments
# --------------------------
.venv/
venv/
env/
ENV/
.python-version

# --------------------------
# Jupyter notebooks
# --------------------------
.ipynb_checkpoints/

# --------------------------
# IDE and editor files
# --------------------------
.vscode/
.idea/
*.suo
*.user
*.code-workspace

# --------------------------
# Operating system files
# --------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# --------------------------
# Environment variables and secrets
# --------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --------------------------
# Logs and temporary files
# --------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# --------------------------
# Training outputs and experiment tracking
# --------------------------
runs/
wandb/
lightning_logs/
tensorboard/
mlruns/
checkpoints/
training_logs/

# --------------------------
# Generated inference output
# Keep deliberately selected example events
# --------------------------
/pulse_events/latest_event.json

# --------------------------
# OS/editor backup files
# --------------------------
*~
